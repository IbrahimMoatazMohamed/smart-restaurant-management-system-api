# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_NAME=smart_restaurant

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# API Configuration
API_BASE_URL=http://localhost:3030

# Cloudinary Configuration (REQUIRED for file uploads)
# Get this from your Cloudinary dashboard: https://cloudinary.com/console
# Copy the "Cloudinary URL" from your dashboard - it includes all credentials
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Real example (replace with your actual values):
# CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz123456@my-restaurant-app

# ⚠️  IMPORTANT: 
# - No spaces around the = sign
# - No quotes around the URL
# - Must start with "cloudinary://"
# - Keep this secret and never commit to version control
